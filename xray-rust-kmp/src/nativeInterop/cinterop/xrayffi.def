# xray_ffi.h comes from the SwiftPM package of the pinned xray-rust-mobile commit and
# libxray_ffi.a from the XrayRust.xcframework of the same release (see release/mobile.env).
# The slice directory is passed per target with -libraryPath; the archive is embedded in the klib.
# The archive needs only libSystem (checked with nm -u on 0.9.0), so no extra linkerOpts.
headers = xray_ffi.h
headerFilter = xray_ffi.h
package = io.github.aimalygin.xrayrust.ffi
staticLibraries = libxray_ffi.a
