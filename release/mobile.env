# Pinned xray-rust-mobile release. Gradle reads XRAY_RUST_MOBILE_VERSION from this
# file; the iOS build takes the XCFramework URL/checksum and header hash from it.
XRAY_RUST_MOBILE_REPOSITORY=https://github.com/aimalygin/xray-rust-mobile.git
XRAY_RUST_MOBILE_VERSION=0.9.0
XRAY_RUST_MOBILE_TAG=v0.9.0
XRAY_RUST_MOBILE_TAG_OBJECT=a564070e071ededa893b2ffcdd8dbab79b77b5c2
XRAY_RUST_MOBILE_COMMIT=52fbde689da1ebe6c95c55b6f83d48c98ca8dee3
XRAY_RUST_MOBILE_MAVEN_COORDINATES=io.github.aimalygin:xray-rust-mobile
XRAY_RUST_MOBILE_AAR_SHA256=8f882b5bba982bc0eb44439e1b02eb963299f8929dcfa93ec99246f6c7e78c50
XRAY_RUST_MOBILE_XCFRAMEWORK_URL=https://github.com/aimalygin/xray-rust-mobile/releases/download/v0.9.0/XrayRust.xcframework.zip
XRAY_RUST_MOBILE_XCFRAMEWORK_ZIP_SHA256=3e9d8191cb70fe8ea350cbbfa444706e4707d68e3330563bac178e4cf387cf52
XRAY_RUST_FFI_HEADER_PATH=Sources/XrayRustFFI/include/xray_ffi.h
XRAY_RUST_FFI_HEADER_SHA256=0217786295f74bdab84fa9daab8bb97b02aa63bc72420d96e70dce7d45e68353
XRAY_RUST_MODULEMAP_SHA256=28552741cc3df9540cef79770cc103c516dbc565dc87387be01a86ef38066f11
XRAY_RUST_MODULEMAP_PATH=Sources/XrayRustFFI/include/module.modulemap
# Raw source of the SwiftPM package at XRAY_RUST_MOBILE_COMMIT (the tag's commit); header and
# modulemap hashes above are copied from that tag's release/core.env.
XRAY_RUST_MOBILE_RAW_BASE_URL=https://raw.githubusercontent.com/aimalygin/xray-rust-mobile
XRAY_RUST_CORE_TAG=v0.9.0
XRAY_RUST_CORE_COMMIT=30928ad51b4a434546cf143f8e385a8746523172
# FFI ABI of the pinned release; Gradle generates XrayRuntime.bindingAbi from these two keys.
XRAY_FFI_ABI_MAJOR=1
XRAY_FFI_ABI_MINOR=15
